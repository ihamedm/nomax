# Leave empty to use the Vite dev proxy: /api -> http://127.0.0.1:8001
# For a deployed frontend point this at the public API origin, e.g.
# VITE_API_BASE_URL=https://api.nomax.ir
VITE_API_BASE_URL=

# "local" enables development-only UI affordances (dev OTP hints).
VITE_APP_ENV=local

# Neshan Web Map SDK key (starts with "web."). Keep the real key in .env only;
# this file is committed. Maps degrade gracefully when the key is empty.
VITE_NESHAN_MAP_KEY=

# Behbahan city center; used when the visitor has not shared a location.
VITE_MAP_CENTER_LAT=30.6380
VITE_MAP_CENTER_LNG=50.8380
VITE_MAP_DEFAULT_ZOOM=13
