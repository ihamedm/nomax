# Local development defaults (matches docker-compose.yml).
# Copy to backend/.env and adjust for your environment.

APP_ENV=local
DEBUG=true
MAX_BUSINESSES_PER_OWNER=1

# docker-compose exposes Postgres on 5433 and Redis on 6380 to avoid clashing
# with other local projects. Use 5432/6379 when running them directly.
DATABASE_URL=postgresql+asyncpg://nomax:secret@localhost:5433/nomax
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6380/0

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=nomax-local-dev-secret-change-me-please-0123456789abcdef
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

OTP_TTL_SECONDS=120
# 0 disables OTP request throttling in development. Production keeps 3.
OTP_RATE_LIMIT_PER_HOUR=0
OTP_MAX_ATTEMPTS=5

# "console" keeps OTPs in Redis and exposes them through /api/v1/admin/dev/otps.
# "mellipayamak" uses a pre-approved shared-service pattern (bodyId).
SMS_PROVIDER=console
SMS_API_URL=https://rest.payamak-panel.com/api/SendSMS/BaseServiceNumber
SMS_USERNAME=
SMS_PASSWORD=
SMS_OTP_BODY_ID=0
SMS_TIMEOUT_SECONDS=8
SMS_MAX_ATTEMPTS=2

DEV_OTP_ENABLED=true

# Address geocoding used by the business map picker (Nominatim by default).
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=NOMAX/1.0 (+https://nomax.ir)
GEOCODER_TIMEOUT_SECONDS=8
GEOCODER_COUNTRY_CODES=ir
# Behbahan city bounding box (left,top,right,bottom).
GEOCODER_VIEWBOX=50.18,30.65,50.30,30.54
GEOCODER_BOUNDED=true

# ArvanCloud S3 (S3-compatible, path-style). Fill credentials to use S3 for
# uploads and the dashboard file manager. Local fallback is used when empty.
S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=nomax-public
S3_BUCKET_PRIVATE=nomax-private
S3_PUBLIC_URL=
S3_ADDRESSING_STYLE=path
S3_HEALTHCHECK_TTL_SECONDS=30
UPLOAD_DIR=/tmp/nomax/uploads

# Set object ACLs to public-read in the public bucket (ArvanCloud).
S3_PUBLIC_READ_ACL=true
