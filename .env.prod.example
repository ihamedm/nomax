DOMAIN=nomax.example.ir
POSTGRES_USER=nomax
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nomax
JWT_SECRET=change-me-to-a-long-random-string
MAX_BUSINESSES_PER_OWNER=1
MAX_BUSINESS_IMAGES=6

# ArvanCloud S3 — required in production.
S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_ACCESS_KEY=replace-with-arvan-access-key
S3_SECRET_KEY=replace-with-arvan-secret-key
S3_BUCKET_PUBLIC=nomax-public
S3_BUCKET_PRIVATE=nomax-private
S3_PUBLIC_URL=
S3_ADDRESSING_STYLE=path
S3_HEALTHCHECK_TTL_SECONDS=30

# Geocoding is restricted to Behbahan by default.
GEOCODER_VIEWBOX=50.18,30.65,50.30,30.54
GEOCODER_BOUNDED=true

# Set object ACLs to public-read in the public bucket (ArvanCloud).
S3_PUBLIC_READ_ACL=true

# Database backup/restore dashboard (superadmin only)
BACKUP_DIR=/data/backups
BACKUP_MAX_UPLOAD_MB=512
# Manual and automatic backups are gzipped into the private Arvan bucket.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=database-backups
BACKUP_KEEP_REMOTE=30
# Daily automatic dump in Tehran time (03:00 by default).
BACKUP_DAILY_ENABLED=true
BACKUP_DAILY_HOUR=3
BACKUP_DAILY_MINUTE=0
BACKUP_TIMEZONE=Asia/Tehran

# Optional Laya System-1 category suggestions. TEMPORARILY DISABLED for the
# beta: keep LAYA_ENABLED=false and do not start the `laya` profile. To enable
# it later, start the sidecar and set LAYA_ENABLED=true:
#   docker compose -f docker-compose.prod.yml --profile laya up -d
# If it is false or the sidecar is down, the owner simply picks the category
# manually.
LAYA_ENABLED=false
LAYA_API_KEY=
# Keep the Persian alias layer on; set false to benchmark raw Laya.
LAYA_RULES_ENABLED=true
LAYA_TIMEOUT_SECONDS=8
LAYA_MIN_CATEGORY_CONFIDENCE=0.55
LAYA_MIN_CATEGORY_MARGIN=0.08
LAYA_MIN_SUBCATEGORY_CONFIDENCE=0.40
LAYA_HIGH_CONFIDENCE=0.80
LAYA_MEDIUM_CONFIDENCE=0.55
LAYA_MAX_SUGGESTIONS=3
