DOMAIN=biznestly.ir
POSTGRES_USER=nomax
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nomax
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
MAX_BUSINESSES_PER_OWNER=1
MAX_BUSINESS_IMAGES=6

# SMS OTP — required in production. With SMS_PROVIDER=console nothing is sent
# and, because APP_ENV=production, the code is never returned by the API
# either, so nobody can log in. Fill the Mellipayamak shared-service values.
SMS_PROVIDER=mellipayamak
SMS_API_URL=https://rest.payamak-panel.com/api/SendSMS/BaseServiceNumber
SMS_USERNAME=
SMS_PASSWORD=
SMS_OTP_BODY_ID=0
SMS_TIMEOUT_SECONDS=8
SMS_MAX_ATTEMPTS=2
OTP_RATE_LIMIT_PER_HOUR=3
DEV_OTP_ENABLED=false

# Shahkar (api.ir) mobile↔national-ID match. Registration is gated on this;
# with an empty key the check is skipped silently, so fill it.
SHAHKAR_API_URL=https://s.api.ir/api/sw1/Shahkar
SHAHKAR_API_KEY=
SHAHKAR_TIMEOUT_SECONDS=10

# Brute-force / SMS-abuse protection.
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_BLOCK_SECONDS=900
LOGIN_RATE_LIMIT_PER_HOUR=30
REGISTER_RATE_LIMIT_PER_HOUR=5
CHECK_RATE_LIMIT_PER_HOUR=60

# Host package mirrors used by `deploy/setup-mirrors.sh` (run as root:
#   sudo ./deploy/setup-mirrors.sh .env.prod
# ). Rewrite the Ubuntu apt sources and the Docker daemon registry mirror.
# Each defaults to its Liara mirror when omitted; point one at the official
# URL (archive.ubuntu.com / security.ubuntu.com / docker.io) to bypass it.
APT_MIRROR_URL=http://linux-mirror.liara.ir/repository/ubuntu/
APT_MIRROR_SECURITY_URL=http://linux-mirror.liara.ir/repository/ubuntu-security/
DOCKER_MIRROR_URL=https://docker-mirror.liara.ir

# Image build package indexes. Defaults are the public registries; change
# them if the VPS cannot resolve files.pythonhosted.org / registry.npmjs.org.
PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
NPM_REGISTRY=https://registry.npmmirror.com
# Debian apt mirror for the backend image build (python:3.12-slim runs
# apt-get for postgresql-client). Defaults to the Liara Debian mirror.
DEBIAN_MIRROR_URL=http://linux-mirror.liara.ir/repository/debian
DEBIAN_MIRROR_SECURITY_URL=http://linux-mirror.liara.ir/repository/debian-security

# Frontend build-time configuration (baked into the JS bundle on `build`).
# Keep VITE_API_BASE_URL empty: the SPA calls the API on the same origin.
VITE_API_BASE_URL=
VITE_APP_ENV=production
# Neshan web SDK key ("web.*"). Empty = map degrades to the manual picker.
VITE_NESHAN_MAP_KEY=
VITE_MAP_CENTER_LAT=30.638
VITE_MAP_CENTER_LNG=50.838
VITE_MAP_DEFAULT_ZOOM=13

# ArvanCloud S3 — required in production. Use the endpoint/region of the
# account that owns the buckets (e.g. ir-thr-at1 or ir-central1).
S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_ACCESS_KEY=replace-with-arvan-access-key
S3_SECRET_KEY=replace-with-arvan-secret-key
S3_BUCKET_PUBLIC=nomax-public
S3_BUCKET_PRIVATE=nomax-private
# Optional public base URL for the public bucket, e.g. a CDN/custom domain
# such as https://s3.biznestly.ir. Empty = derive from the endpoint.
S3_PUBLIC_URL=
S3_ADDRESSING_STYLE=path
S3_HEALTHCHECK_TTL_SECONDS=30

# Geocoding is restricted to Behbahan by default.
GEOCODER_VIEWBOX=50.18,30.65,50.30,30.54
GEOCODER_BOUNDED=true

# Set object ACLs to public-read in the public bucket (ArvanCloud).
S3_PUBLIC_READ_ACL=true

# Database backup/restore dashboard (superadmin only)
BACKUP_DIR=/data/backups
BACKUP_MAX_UPLOAD_MB=512
# Manual and automatic backups are gzipped into the private Arvan bucket.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=database-backups
BACKUP_KEEP_REMOTE=30
# Daily automatic dump in Tehran time (03:00 by default).
BACKUP_DAILY_ENABLED=true
BACKUP_DAILY_HOUR=3
BACKUP_DAILY_MINUTE=0
BACKUP_TIMEZONE=Asia/Tehran

# Optional Laya System-1 category suggestions. TEMPORARILY DISABLED for the
# beta: keep LAYA_ENABLED=false and do not start the `laya` profile. To enable
# it later, start the sidecar and set LAYA_ENABLED=true:
#   docker compose -f docker-compose.prod.yml --profile laya up -d
# If it is false or the sidecar is down, the owner simply picks the category
# manually.
LAYA_ENABLED=false
LAYA_API_KEY=
# Keep the Persian alias layer on; set false to benchmark raw Laya.
LAYA_RULES_ENABLED=true
LAYA_TIMEOUT_SECONDS=8
LAYA_MIN_CATEGORY_CONFIDENCE=0.55
LAYA_MIN_CATEGORY_MARGIN=0.08
LAYA_MIN_SUBCATEGORY_CONFIDENCE=0.40
LAYA_HIGH_CONFIDENCE=0.80
LAYA_MEDIUM_CONFIDENCE=0.55
LAYA_MAX_SUGGESTIONS=3
